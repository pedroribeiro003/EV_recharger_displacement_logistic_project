# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ev_demand

# Tupi API
TUPI_BASE_URL=https://api.tupimob.com
TUPI_ORIGIN=https://tupimob.com
POLL_INTERVAL=60  # seconds between polls

# ANP API
ANP_BASE_URL=https://www.anp.gov.br/api

# IPEA Data
IPEA_BASE_URL=http://www.ipeadata.gov.br/api/odata4

# OSM Overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Logging
LOG_LEVEL=INFO
LOG_FILE=ev_demand.log
