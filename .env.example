# Copie para .env e preencha os valores:  cp .env.example .env

# PostgreSQL — formato completo de conexão
DATABASE_URL=postgresql+psycopg2://ev_demand:SENHA_AQUI@localhost:5432/ev_demand

# Tupi API
TUPI_BASE_URL=https://api.tupinambaenergia.com.br
TUPI_ORIGIN=https://tupimob.com
POLL_INTERVAL=300

# ANP API
ANP_BASE_URL=https://www.gov.br/anp/pt-br/api

# IPEA Data
IPEA_BASE_URL=http://www.ipeadata.gov.br/api/odata4

# OSM Overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Logging
LOG_LEVEL=INFO
LOG_FILE=ev_demand.log
