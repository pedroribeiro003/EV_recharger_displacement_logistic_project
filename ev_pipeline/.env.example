# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ev_charging
DB_USER=ev_user
DB_PASSWORD=your_password_here
DB_SCHEMA_STAGING=staging
DB_SCHEMA_CORE=core
DB_SCHEMA_ANALYTICS=analytics

# Pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── API Keys ────────────────────────────────────────────────
OPEN_CHARGE_MAP_API_KEY=your_ocm_key_here
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v1

# ── Pipeline ────────────────────────────────────────────────
PIPELINE_BATCH_SIZE=500
PIPELINE_REQUEST_TIMEOUT=30
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY=2

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
